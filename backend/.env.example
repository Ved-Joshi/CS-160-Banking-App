# Server Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000

# JWT
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_EXPIRES_MIN=60

# Backend data layer
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS (JSON array)
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Optional integrations
GOOGLE_MAPS_API_KEY=
TRANSFER_RUNNER_SECRET=replace-with-long-random-secret
EXTERNAL_ACCOUNT_PROVIDER=stripe_sandbox
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Demo seed account (used by docker-compose seed service)
SEED_DEMO_DATA=true
DEMO_TEST_EMAIL=demo.tester@example.com
DEMO_TEST_PASSWORD=DemoPass123!
DEMO_RECIPIENT_EMAIL=demo.recipient@example.com
DEMO_RECIPIENT_PASSWORD=DemoPass123!
